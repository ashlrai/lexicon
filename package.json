{
  "name": "@ashlr/lexicon",
  "mcpName": "io.github.ashlrai/lexicon",
  "version": "0.5.7",
  "description": "Personal lexicon for voice-to-agents. Fixes the words STT gets wrong (Ashler -> Ashlr.AI) before your agent sees the prompt.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://lexicon.ashlr.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashlrai/lexicon.git"
  },
  "bugs": {
    "url": "https://github.com/ashlrai/lexicon/issues"
  },
  "author": "Ashlr.AI",
  "bin": {
    "lexicon": "./dist/cli/index.js",
    "lexicon-mcp": "./dist/mcp/server.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "plugin",
    "packs",
    "skills",
    "commands",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "README.md"
  ],
  "scripts": {
    "check:crypto": "node --test scripts/check-crypto.test.mjs && node scripts/check-crypto.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "build:bundle": "node scripts/build-bundle.mjs",
    "prepare": "npm run build && npm run build:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "node --test test/hook-main-sonar.test.mjs tests/docs-index-first-run.test.mjs tests/setup-dotted-brand.test.mjs && vitest run",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p extension/tsconfig.json --noEmit && tsc -p site/tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "mcp": "node dist/mcp/server.js",
    "bench": "node --import tsx bench/run.ts",
    "bench:audio": "node --import tsx bench/audio/run.ts",
    "bench:hook": "node bench/hook-latency.mjs",
    "docs:cli": "node --import tsx scripts/gen-cli-docs.ts",
    "check:links": "node --test scripts/check-links.test.mjs && node scripts/check-links.mjs",
    "resolve:conflicts": "node scripts/resolve-merge-conflicts.mjs",
    "check:server-json": "node scripts/check-server-json.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "fresh:check": "node scripts/freshness/check.mjs",
    "fresh:sync": "node scripts/freshness/sync.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm run build:bundle && npm test",
    "build:site": "node scripts/build-site.mjs",
    "dev:site": "npm run build:site && node site/serve.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "bench:compare": "node --import tsx bench/audio/compare.ts",
    "bench:non-english": "node --import tsx scripts/bench-non-english.mjs"
  },
  "keywords": [
    "mcp",
    "dictation",
    "voice",
    "speech-to-text",
    "vocabulary",
    "claude-code",
    "lexicon"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.3",
    "double-metaphone": "^2.0.1",
    "fastest-levenshtein": "^1.0.16",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
