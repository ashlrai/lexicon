    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "simple-icons": "16.31.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
