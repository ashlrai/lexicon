# Vercel uses this INSTEAD of .gitignore when deciding what to upload.
#
# lib/generated is deliberately absent from this list. It holds the browser
# bundle of the real src/core, generated by scripts/build-demo-bundle.mjs from
# files in the parent repository — which is not uploaded when this directory
# deploys on its own. Shipping the prebuilt artifacts is what makes `vercel
# --cwd web` work. Regenerate them (npm run build) before every deploy.
node_modules
.next
.vercel
