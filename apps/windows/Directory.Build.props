<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701</WarningsNotAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Lets `dotnet build` / `dotnet publish -r win-x64` run on macOS and Linux.
         The build is cross-platform; the result only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.5.4</Version>
    <Company>Ashlr.AI</Company>
    <Product>LexiconBar</Product>
  </PropertyGroup>
</Project>
